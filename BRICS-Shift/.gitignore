# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/

# Virtual environments
.venv/
venv/

# Build and packaging output
build/
dist/
*.egg-info/

# Coverage output
.coverage
htmlcov/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local Streamlit configuration and secrets
.streamlit/secrets.toml

# Runtime database files
*.db
*.db-shm
*.db-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Generated research data (directory placeholders remain tracked)
data/raw/*
data/processed/*
data/exports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep
